{
  "name": "jaquette",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:reference": "node scripts/check-reference-integrity.mjs",
    "prepare:references": "node scripts/prepare-references.mjs",
    "test:tooling": "node --test scripts/qualification.test.mjs",
    "validate:diagnostic": "node scripts/validate-diagnostic.mjs",
    "validate:all": "pnpm validate && pnpm test:tooling && pnpm test:e2e",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:links && pnpm check:secrets && pnpm check:reference"
  },
  "dependencies": {
    "@fontsource/literata": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
